---
config:
  theme: dark
  layout: dagre
---

%% Full composite ERM. Built-capability fragments: docs/erm/<capability>.mmd
%% Planned work (Clubs/Metrics/Visibility): docs/erm/planned-clubs-metrics-visibility.mmd

erDiagram
  %% === Identity & Classification ===
  USER_ACCOUNT {
    string id PK
    string supabase_user_id UK
    string role
    string status
    datetime created_at
    datetime updated_at
  }

  SPORT {
    string id PK
    string name UK
    string category
    boolean is_active
  }

  ATHLETE {
    string id PK
    string user_account_id FK,UK
    string slug UK
    string display_name
    string sport_id FK
    string country_code
    string profile_status
    boolean is_under_legal_hold
    datetime created_at
    datetime updated_at
  }

  USER_ACCOUNT ||--|| ATHLETE : "owns"
  SPORT ||--o{ ATHLETE : "classified_by"

  %% === Profiles ===
  ATHLETE_PUBLIC_PROFILE {
    string athlete_id PK,FK
    text public_bio
    string city
    string primary_position
    int height_cm
    float weight_kg
    int connection_count_cache
    string avatar_asset_id FK
    boolean is_searchable
    datetime updated_at
  }

  ATHLETE_PRIVATE_PROFILE {
    string athlete_id PK,FK
    bytes exact_dob_enc
    bytes contact_email_enc
    bytes contact_phone_enc
    bytes gov_id_enc
    string encryption_key_version
    string onboarding_status
    datetime updated_at
  }

  PROFILE_PHOTO_ASSET {
    string id PK
    string athlete_id FK
    string variant
    string object_path
    int width
    int height
    string processing_status
    datetime created_at
  }

  ATHLETE ||--|| ATHLETE_PUBLIC_PROFILE : "has_public_profile"
  ATHLETE ||--|| ATHLETE_PRIVATE_PROFILE : "has_private_profile"
  ATHLETE ||--o{ PROFILE_PHOTO_ASSET : "uploads_photo"
  ATHLETE_PUBLIC_PROFILE ||--o| PROFILE_PHOTO_ASSET : "avatar_photo"

  %% === Activities ===
  ATHLETE_ACHIEVEMENT {
    string id PK
    string athlete_id FK
    string title
    string organization
    date achieved_on
    string verification_status
    string verification_source
    datetime created_at
  }

  ATHLETE_CONNECTION {
    string id PK
    string requester_id FK
    string addressee_id FK
    string status
    datetime created_at
    datetime responded_at
  }

  ATHLETE ||--o{ ATHLETE_ACHIEVEMENT : "earns"
  ATHLETE ||--o{ ATHLETE_CONNECTION : "initiates_or_receives"

  %% === Clubs, Metrics & Visibility (PLANNED — ADR-013) ===
  %% Not yet in prisma/schema.prisma. Entity-level only: PK/FK and the
  %% state field that ADR-013 depends on. Full field lists are defined by the
  %% openspec change that introduces them; do not infer fields from this block.
  CLUB {
    string id PK
  }

  CLUB_TRAINER {
    string id PK
    string club_id FK
    string user_account_id FK
  }

  CLUB_MEMBERSHIP {
    string id PK
    string club_id FK
    string athlete_id FK
    string status "PENDING_ATHLETE_CONFIRMATION | ACTIVE | COMPLETED | REJECTED"
  }

  METRIC_DEFINITION {
    string id PK
  }

  ATHLETE_METRIC_ENTRY {
    string id PK
    string athlete_id FK
    string metric_definition_id FK
    string reported_by_club_trainer_id FK
  }

  ATHLETE_METRIC_SUMMARY {
    string athlete_id FK
    string metric_definition_id FK
  }

  ATHLETE_VISIBILITY_SETTINGS {
    string athlete_id PK,FK
  }

  CLUB ||--o{ CLUB_TRAINER : "staffed_by"
  USER_ACCOUNT ||--o{ CLUB_TRAINER : "acts_as_trainer"
  CLUB ||--o{ CLUB_MEMBERSHIP : "has_members"
  ATHLETE ||--o{ CLUB_MEMBERSHIP : "belongs_to"
  METRIC_DEFINITION ||--o{ ATHLETE_METRIC_ENTRY : "defines"
  ATHLETE ||--o{ ATHLETE_METRIC_ENTRY : "has_entries"
  CLUB_TRAINER ||--o{ ATHLETE_METRIC_ENTRY : "reports"
  METRIC_DEFINITION ||--o{ ATHLETE_METRIC_SUMMARY : "summarized_by"
  ATHLETE ||--o{ ATHLETE_METRIC_SUMMARY : "has_summaries"
  ATHLETE ||--|| ATHLETE_VISIBILITY_SETTINGS : "controls_visibility"

  %% === Compliance & Audit ===
  PII_CONSENT_LOG {
    string id PK
    string athlete_id FK
    string purpose_code
    string consent_version
    boolean granted
    datetime granted_at
    datetime revoked_at
    string evidence_ref
  }

  AUDIT_EVENT {
    string id PK
    string actor_user_account_id FK
    string athlete_id FK
    string event_type
    string target_type
    string target_id
    string purpose_code
    string request_id
    json metadata
    datetime created_at
  }

  DATA_LIFECYCLE_REQUEST {
    string id PK
    string athlete_id FK
    string requested_by FK
    string request_type
    string status
    string artifact_path
    datetime created_at
    datetime expires_at
    datetime completed_at
  }

  ATHLETE ||--o{ PII_CONSENT_LOG : "grants"
  USER_ACCOUNT ||--o{ AUDIT_EVENT : "logs_event"
  ATHLETE ||--o{ AUDIT_EVENT : "subject_of"
  USER_ACCOUNT ||--o{ DATA_LIFECYCLE_REQUEST : "submits_request"
  ATHLETE ||--o{ DATA_LIFECYCLE_REQUEST : "data_subject"
  