---
config:
  theme: dark
  layout: dagre
---

%% Full composite ERM. Built-capability fragments: docs/erm/<capability>.mmd

erDiagram
  %% === Identity & Classification ===
  USER_ACCOUNT {
    string id PK
    string supabase_user_id UK
    string role
    string status
    datetime created_at
    datetime updated_at
  }

  SPORT {
    string id PK
    string name UK
    string category
    boolean is_active
  }

  ATHLETE {
    string id PK
    string user_account_id FK,UK
    string slug UK
    string display_name
    string sport_id FK
    string country_code
    string profile_status
    boolean is_under_legal_hold
    datetime created_at
    datetime updated_at
  }

  USER_ACCOUNT ||--|| ATHLETE : "owns"
  SPORT ||--o{ ATHLETE : "classified_by"

  %% === Profiles ===
  ATHLETE_PUBLIC_PROFILE {
    string athlete_id PK,FK
    text public_bio
    string city
    string primary_position
    int height_cm
    float weight_kg
    int connection_count_cache
    string avatar_asset_id FK
    boolean is_searchable
    datetime updated_at
  }

  ATHLETE_PRIVATE_PROFILE {
    string athlete_id PK,FK
    bytes exact_dob_enc
    bytes contact_email_enc
    bytes contact_phone_enc
    bytes gov_id_enc
    string encryption_key_version
    string onboarding_status
    datetime updated_at
  }

  PROFILE_PHOTO_ASSET {
    string id PK
    string athlete_id FK
    string variant
    string object_path
    int width
    int height
    string processing_status
    datetime created_at
  }

  ATHLETE ||--|| ATHLETE_PUBLIC_PROFILE : "has_public_profile"
  ATHLETE ||--|| ATHLETE_PRIVATE_PROFILE : "has_private_profile"
  ATHLETE ||--o{ PROFILE_PHOTO_ASSET : "uploads_photo"
  ATHLETE_PUBLIC_PROFILE ||--o| PROFILE_PHOTO_ASSET : "avatar_photo"

  %% === Activities ===
  ATHLETE_ACHIEVEMENT {
    string id PK
    string athlete_id FK
    string title
    string organization
    date achieved_on
    string verification_status
    string verification_source
    datetime created_at
  }

  ATHLETE_CONNECTION {
    string id PK
    string requester_id FK
    string addressee_id FK
    string status
    datetime created_at
    datetime responded_at
  }

  ATHLETE ||--o{ ATHLETE_ACHIEVEMENT : "earns"
  ATHLETE ||--o{ ATHLETE_CONNECTION : "initiates_or_receives"

  %% === Clubs, Metrics & Visibility (ADR-013) ===
  CLUB {
    string id PK
    string slug UK
    string name
    string country_code
    string city
    datetime created_at
  }

  CLUB_TRAINER {
    string id PK
    string club_id FK
    string user_account_id FK
    datetime created_at
  }

  CLUB_MEMBERSHIP {
    string id PK
    string club_id FK
    string athlete_id FK
    string status "PENDING_ATHLETE_CONFIRMATION | ACTIVE | COMPLETED | REJECTED"
    string invited_by_club_trainer_id FK
    datetime created_at
    datetime responded_at
    datetime ended_at
  }

  METRIC_DEFINITION {
    string id PK
    string key UK
    string name
    string unit
    string sport_id FK
    boolean is_active
  }

  ATHLETE_METRIC_ENTRY {
    string id PK
    string athlete_id FK
    string metric_definition_id FK
    string club_membership_id FK
    string reported_by_club_trainer_id FK
    decimal value
    datetime measured_at
    datetime created_at
  }

  ATHLETE_METRIC_SUMMARY {
    string athlete_id PK,FK
    string metric_definition_id PK,FK
    decimal latest_value
    datetime latest_measured_at
    int entry_count
    datetime updated_at
  }

  ATHLETE_VISIBILITY_SETTINGS {
    string athlete_id PK,FK
    string club_memberships_audience "PRIVATE | CONNECTIONS | PUBLIC"
    string metrics_audience "PRIVATE | CONNECTIONS | PUBLIC"
    string achievements_audience "PRIVATE | CONNECTIONS | PUBLIC (default PUBLIC)"
    datetime updated_at
  }

  CLUB ||--o{ CLUB_TRAINER : "staffed_by"
  USER_ACCOUNT ||--o{ CLUB_TRAINER : "acts_as_trainer"
  CLUB ||--o{ CLUB_MEMBERSHIP : "has_members"
  ATHLETE ||--o{ CLUB_MEMBERSHIP : "belongs_to"
  CLUB_TRAINER ||--o{ CLUB_MEMBERSHIP : "invites"
  SPORT |o--o{ METRIC_DEFINITION : "scopes"
  METRIC_DEFINITION ||--o{ ATHLETE_METRIC_ENTRY : "defines"
  ATHLETE ||--o{ ATHLETE_METRIC_ENTRY : "has_entries"
  CLUB_TRAINER ||--o{ ATHLETE_METRIC_ENTRY : "reports"
  CLUB_MEMBERSHIP ||--o{ ATHLETE_METRIC_ENTRY : "authorizes"
  METRIC_DEFINITION ||--o{ ATHLETE_METRIC_SUMMARY : "summarized_by"
  ATHLETE ||--o{ ATHLETE_METRIC_SUMMARY : "has_summaries"
  ATHLETE ||--o| ATHLETE_VISIBILITY_SETTINGS : "controls_visibility"

  %% === Notifications ===
  DEVICE_TOKEN {
    string id PK
    string user_account_id FK
    string token UK
    string platform "IOS | ANDROID"
    datetime created_at
    datetime last_seen_at
  }

  USER_ACCOUNT ||--o{ DEVICE_TOKEN : "registers_device"

  %% === Compliance & Audit ===
  PII_CONSENT_LOG {
    string id PK
    string athlete_id FK
    string purpose_code
    string consent_version
    boolean granted
    datetime granted_at
    datetime revoked_at
    string evidence_ref
  }

  AUDIT_EVENT {
    string id PK
    string actor_user_account_id FK
    string athlete_id FK
    string event_type
    string target_type
    string target_id
    string purpose_code
    string request_id
    json metadata
    datetime created_at
  }

  DATA_LIFECYCLE_REQUEST {
    string id PK
    string athlete_id FK
    string requested_by FK
    string request_type
    string status
    string artifact_path
    datetime created_at
    datetime expires_at
    datetime completed_at
  }

  ATHLETE ||--o{ PII_CONSENT_LOG : "grants"
  USER_ACCOUNT ||--o{ AUDIT_EVENT : "logs_event"
  ATHLETE ||--o{ AUDIT_EVENT : "subject_of"
  USER_ACCOUNT ||--o{ DATA_LIFECYCLE_REQUEST : "submits_request"
  ATHLETE ||--o{ DATA_LIFECYCLE_REQUEST : "data_subject"
  