// Athlete Passport — Prisma schema
// Source of truth: docs/erm.mmd
// Every field carries a data classification tag (L0/L1/L2/L3) per AGENTS.md.
// Encrypted (L2) columns use Bytes and are named with the `_enc` suffix.
// L3 secrets (keys) never appear in this schema — they live in env only.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum UserRole {
  ATHLETE
  SYSTEM

  @@map("user_role")
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("account_status")
}

enum ProfileStatus {
  DRAFT
  ACTIVE
  HIDDEN
  LOCKED

  @@map("profile_status")
}

enum OnboardingStatus {
  NOT_STARTED
  IDENTITY_PENDING
  CONSENT_PENDING
  COMPLETE

  @@map("onboarding_status")
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED

  @@map("connection_status")
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED

  @@map("verification_status")
}

enum PhotoVariant {
  ORIGINAL
  THUMB_150
  CARD_400
  FULL_1200

  @@map("photo_variant")
}

enum ProcessingStatus {
  QUEUED
  RUNNING
  READY
  FAILED

  @@map("processing_status")
}

enum DataLifecycleType {
  EXPORT
  DELETION
  RECTIFICATION

  @@map("data_lifecycle_type")
}

enum DataLifecycleStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  BLOCKED_LEGAL_HOLD
  FAILED

  @@map("data_lifecycle_status")
}

/// ADR-013 §5 — only ACTIVE grants a club's trainers access to the athlete.
enum ClubMembershipStatus {
  PENDING_ATHLETE_CONFIRMATION
  ACTIVE
  COMPLETED
  REJECTED

  @@map("club_membership_status")
}

enum VisibilityAudience {
  PRIVATE
  CONNECTIONS
  PUBLIC

  @@map("visibility_audience")
}

enum DevicePlatform {
  IOS
  ANDROID

  @@map("device_platform")
}

// ============================================================================
// Identity & Classification
// ============================================================================

model UserAccount {
  /// L1-INTERNAL
  id             String        @id @default(cuid())
  /// L1-INTERNAL
  supabaseUserId String        @unique @map("supabase_user_id")
  /// L1-INTERNAL
  role           UserRole
  /// L1-INTERNAL
  status         AccountStatus
  /// L1-INTERNAL
  createdAt      DateTime      @default(now()) @map("created_at")
  /// L1-INTERNAL
  updatedAt      DateTime      @updatedAt @map("updated_at")

  athlete                Athlete?
  auditEvents            AuditEvent[]
  submittedLifecycleReqs DataLifecycleRequest[] @relation("LifecycleRequester")
  clubTrainerRoles       ClubTrainer[]
  deviceTokens           DeviceToken[]

  @@map("user_accounts")
}

model Sport {
  /// L0-PUBLIC
  id       String  @id @default(cuid())
  /// L0-PUBLIC
  name     String  @unique
  /// L0-PUBLIC
  category String
  /// L0-PUBLIC
  isActive Boolean @default(true) @map("is_active")

  athletes          Athlete[]
  metricDefinitions MetricDefinition[]

  @@map("sports")
}

model Athlete {
  /// L0-PUBLIC
  id               String        @id @default(cuid())
  /// L1-INTERNAL
  userAccountId    String        @unique @map("user_account_id")
  /// L0-PUBLIC
  slug             String        @unique
  /// L0-PUBLIC
  displayName      String        @map("display_name")
  /// L0-PUBLIC
  sportId          String        @map("sport_id")
  /// L0-PUBLIC
  countryCode      String        @map("country_code")
  /// L1-INTERNAL
  profileStatus    ProfileStatus @default(DRAFT) @map("profile_status")
  /// L3-RESTRICTED — only the project owner may set or clear this flag via direct DB access
  isUnderLegalHold Boolean       @default(false) @map("is_under_legal_hold")
  /// L1-INTERNAL
  createdAt        DateTime      @default(now()) @map("created_at")
  /// L1-INTERNAL
  updatedAt        DateTime      @updatedAt @map("updated_at")

  userAccount          UserAccount                @relation(fields: [userAccountId], references: [id], onDelete: Restrict)
  sport                Sport                      @relation(fields: [sportId], references: [id], onDelete: Restrict)
  publicProfile        AthletePublicProfile?
  privateProfile       AthletePrivateProfile?
  photos               ProfilePhotoAsset[]
  achievements         AthleteAchievement[]
  consentLogs          PiiConsentLog[]
  auditEvents          AuditEvent[]
  lifecycleRequests    DataLifecycleRequest[]
  requestedConnections AthleteConnection[]        @relation("ConnectionRequester")
  receivedConnections  AthleteConnection[]        @relation("ConnectionAddressee")
  clubMemberships      ClubMembership[]
  metricEntries        AthleteMetricEntry[]
  metricSummaries      AthleteMetricSummary[]
  visibilitySettings   AthleteVisibilitySettings?

  @@index([sportId, profileStatus])
  @@index([countryCode, sportId])
  @@map("athletes")
}

// ============================================================================
// Profiles
// ============================================================================

model AthletePublicProfile {
  /// L0-PUBLIC
  athleteId            String   @id @map("athlete_id")
  /// L0-PUBLIC
  publicBio            String?  @map("public_bio") @db.Text
  /// L0-PUBLIC
  city                 String?
  /// L0-PUBLIC
  primaryPosition      String?  @map("primary_position")
  /// L0-PUBLIC
  heightCm             Int?     @map("height_cm")
  /// L0-PUBLIC
  weightKg             Float?   @map("weight_kg")
  /// L0-PUBLIC
  connectionCountCache Int      @default(0) @map("connection_count_cache")
  /// L0-PUBLIC — CONSTRAINT: must reference a ProfilePhotoAsset where
  /// asset.athleteId == this.athleteId AND asset.variant != 'ORIGINAL'.
  /// Enforced by: application layer (tRPC procedure) + supabase/policies/athlete_public_profiles.sql
  /// + supabase/constraints/avatar_ownership.sql (DB trigger)
  avatarAssetId        String?  @unique @map("avatar_asset_id")
  /// L0-PUBLIC
  isSearchable         Boolean  @default(true) @map("is_searchable")
  /// L1-INTERNAL
  updatedAt            DateTime @updatedAt @map("updated_at")

  athlete     Athlete            @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  avatarAsset ProfilePhotoAsset? @relation("PublicProfileAvatar", fields: [avatarAssetId], references: [id], onDelete: Restrict)

  @@index([isSearchable])
  @@map("athlete_public_profiles")
}

model AthletePrivateProfile {
  /// L1-INTERNAL
  athleteId            String           @id @map("athlete_id")
  /// L2-CONFIDENTIAL
  exactDobEnc          Bytes?           @map("exact_dob_enc")
  /// L2-CONFIDENTIAL
  contactEmailEnc      Bytes?           @map("contact_email_enc")
  /// L2-CONFIDENTIAL
  contactPhoneEnc      Bytes?           @map("contact_phone_enc")
  /// L2-CONFIDENTIAL
  govIdEnc             Bytes?           @map("gov_id_enc")
  /// L1-INTERNAL
  encryptionKeyVersion String           @map("encryption_key_version")
  /// L1-INTERNAL
  onboardingStatus     OnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  /// L1-INTERNAL
  updatedAt            DateTime         @updatedAt @map("updated_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Restrict)

  @@map("athlete_private_profiles")
}

model ProfilePhotoAsset {
  /// L0-PUBLIC
  id               String           @id @default(cuid())
  /// L0-PUBLIC
  athleteId        String           @map("athlete_id")
  /// L0-PUBLIC
  variant          PhotoVariant
  /// L1-INTERNAL
  objectPath       String           @map("object_path")
  /// L0-PUBLIC
  width            Int
  /// L0-PUBLIC
  height           Int
  /// L1-INTERNAL
  processingStatus ProcessingStatus @default(QUEUED) @map("processing_status")
  /// L1-INTERNAL
  createdAt        DateTime         @default(now()) @map("created_at")

  athlete           Athlete               @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  publicProfileLink AthletePublicProfile? @relation("PublicProfileAvatar")

  @@unique([athleteId, variant])
  @@map("profile_photo_assets")
}

// ============================================================================
// Activities
// ============================================================================

model AthleteAchievement {
  /// L0-PUBLIC
  id                 String             @id @default(cuid())
  /// L0-PUBLIC
  athleteId          String             @map("athlete_id")
  /// L0-PUBLIC
  title              String
  /// L0-PUBLIC
  organization       String
  /// L0-PUBLIC
  achievedOn         DateTime           @map("achieved_on") @db.Date
  /// L0-PUBLIC
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  /// L0-PUBLIC
  verificationSource String?            @map("verification_source")
  /// L1-INTERNAL
  createdAt          DateTime           @default(now()) @map("created_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Restrict)

  @@index([athleteId, verificationStatus])
  @@map("athlete_achievements")
}

model AthleteConnection {
  /// L1-INTERNAL
  id          String           @id @default(cuid())
  /// L1-INTERNAL
  requesterId String           @map("requester_id")
  /// L1-INTERNAL
  addresseeId String           @map("addressee_id")
  /// L1-INTERNAL
  status      ConnectionStatus @default(PENDING)
  /// L1-INTERNAL
  createdAt   DateTime         @default(now()) @map("created_at")
  /// L1-INTERNAL
  respondedAt DateTime?        @map("responded_at")

  requester Athlete @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  addressee Athlete @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Restrict)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
  @@map("athlete_connections")
}

// ============================================================================
// Compliance & Audit
// ============================================================================

model PiiConsentLog {
  /// L1-INTERNAL
  id             String    @id @default(cuid())
  /// L1-INTERNAL
  athleteId      String    @map("athlete_id")
  /// L1-INTERNAL
  purposeCode    String    @map("purpose_code")
  /// L1-INTERNAL
  consentVersion String    @map("consent_version")
  /// L1-INTERNAL
  granted        Boolean
  /// L1-INTERNAL
  grantedAt      DateTime  @default(now()) @map("granted_at")
  /// L1-INTERNAL
  revokedAt      DateTime? @map("revoked_at")
  /// L1-INTERNAL
  evidenceRef    String?   @map("evidence_ref")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Restrict)

  @@index([athleteId, purposeCode])
  @@map("pii_consent_log")
}

/// Every audit event MUST have an actor and a subject athlete.
/// For system/background actions, use the SYSTEM_ACCOUNT user (seeded UserAccount with role=SYSTEM).
model AuditEvent {
  /// L1-INTERNAL
  id                 String   @id @default(cuid())
  /// L1-INTERNAL — who performed the action (use SYSTEM_ACCOUNT for background jobs)
  actorUserAccountId String   @map("actor_user_account_id")
  /// L1-INTERNAL — subject athlete; required so RLS can scope audit visibility
  athleteId          String   @map("athlete_id")
  /// L1-INTERNAL
  eventType          String   @map("event_type")
  /// L1-INTERNAL
  targetType         String   @map("target_type")
  /// L1-INTERNAL
  targetId           String   @map("target_id")
  /// L1-INTERNAL
  purposeCode        String   @map("purpose_code")
  /// L1-INTERNAL
  requestId          String   @map("request_id")
  /// L1-INTERNAL
  metadata           Json?
  /// L1-INTERNAL
  createdAt          DateTime @default(now()) @map("created_at")

  actor   UserAccount @relation(fields: [actorUserAccountId], references: [id], onDelete: Restrict)
  athlete Athlete     @relation(fields: [athleteId], references: [id], onDelete: Restrict)

  @@index([actorUserAccountId, createdAt])
  @@index([athleteId, createdAt])
  @@index([eventType, createdAt])
  @@map("audit_log")
}

model DataLifecycleRequest {
  /// L1-INTERNAL
  id           String              @id @default(cuid())
  /// L1-INTERNAL
  athleteId    String              @map("athlete_id")
  /// L1-INTERNAL
  requestedBy  String              @map("requested_by")
  /// L1-INTERNAL
  requestType  DataLifecycleType   @map("request_type")
  /// L1-INTERNAL
  status       DataLifecycleStatus @default(REQUESTED)
  /// L1-INTERNAL
  artifactPath String?             @map("artifact_path")
  /// L1-INTERNAL
  createdAt    DateTime            @default(now()) @map("created_at")
  /// L1-INTERNAL
  expiresAt    DateTime?           @map("expires_at")
  /// L1-INTERNAL
  completedAt  DateTime?           @map("completed_at")

  athlete         Athlete     @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  requestedByUser UserAccount @relation("LifecycleRequester", fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([athleteId, status])
  @@index([status, createdAt])
  @@map("data_lifecycle_requests")
}

// ============================================================================
// Clubs, Metrics & Visibility (ADR-013)
// Clubs, trainers, and metric definitions are provisioned out-of-band.
// ============================================================================

model Club {
  /// L0-PUBLIC
  id          String   @id @default(cuid())
  /// L0-PUBLIC
  slug        String   @unique
  /// L0-PUBLIC
  name        String
  /// L0-PUBLIC
  countryCode String   @map("country_code")
  /// L0-PUBLIC
  city        String?
  /// L1-INTERNAL
  createdAt   DateTime @default(now()) @map("created_at")

  trainers    ClubTrainer[]
  memberships ClubMembership[]

  @@map("clubs")
}

/// A user is a trainer of a club only through a row here; there is no global trainer role.
model ClubTrainer {
  /// L1-INTERNAL
  id            String   @id @default(cuid())
  /// L1-INTERNAL
  clubId        String   @map("club_id")
  /// L1-INTERNAL
  userAccountId String   @map("user_account_id")
  /// L1-INTERNAL
  createdAt     DateTime @default(now()) @map("created_at")

  club            Club                 @relation(fields: [clubId], references: [id], onDelete: Restrict)
  userAccount     UserAccount          @relation(fields: [userAccountId], references: [id], onDelete: Restrict)
  sentInvitations ClubMembership[]
  reportedEntries AthleteMetricEntry[]

  @@unique([clubId, userAccountId])
  @@index([userAccountId])
  @@map("club_trainers")
}

/// At most one PENDING_ATHLETE_CONFIRMATION/ACTIVE row per (club, athlete):
/// enforced by a partial unique index in supabase/constraints/ (not expressible in Prisma).
model ClubMembership {
  /// L1-INTERNAL
  id                     String               @id @default(cuid())
  /// L0-PUBLIC
  clubId                 String               @map("club_id")
  /// L1-INTERNAL
  athleteId              String               @map("athlete_id")
  /// L1-INTERNAL
  status                 ClubMembershipStatus @default(PENDING_ATHLETE_CONFIRMATION)
  /// L1-INTERNAL
  invitedByClubTrainerId String               @map("invited_by_club_trainer_id")
  /// L1-INTERNAL
  createdAt              DateTime             @default(now()) @map("created_at")
  /// L1-INTERNAL
  respondedAt            DateTime?            @map("responded_at")
  /// L1-INTERNAL
  endedAt                DateTime?            @map("ended_at")

  club          Club                 @relation(fields: [clubId], references: [id], onDelete: Restrict)
  athlete       Athlete              @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  invitedBy     ClubTrainer          @relation(fields: [invitedByClubTrainerId], references: [id], onDelete: Restrict)
  metricEntries AthleteMetricEntry[]

  @@index([clubId, athleteId, status])
  @@index([athleteId, status])
  @@map("club_memberships")
}

model MetricDefinition {
  /// L0-PUBLIC
  id       String  @id @default(cuid())
  /// L0-PUBLIC
  key      String  @unique
  /// L0-PUBLIC
  name     String
  /// L0-PUBLIC
  unit     String
  /// L0-PUBLIC
  sportId  String? @map("sport_id")
  /// L0-PUBLIC
  isActive Boolean @default(true) @map("is_active")

  sport     Sport?                 @relation(fields: [sportId], references: [id], onDelete: Restrict)
  entries   AthleteMetricEntry[]
  summaries AthleteMetricSummary[]

  @@map("metric_definitions")
}

/// Append-only. A DB trigger in supabase/constraints/ rejects inserts whose
/// membership is not ACTIVE or belongs to a different athlete.
model AthleteMetricEntry {
  /// L1-INTERNAL
  id                      String   @id @default(cuid())
  /// L1-INTERNAL
  athleteId               String   @map("athlete_id")
  /// L1-INTERNAL
  metricDefinitionId      String   @map("metric_definition_id")
  /// L1-INTERNAL — the ACTIVE membership that authorized the write
  clubMembershipId        String   @map("club_membership_id")
  /// L1-INTERNAL
  reportedByClubTrainerId String   @map("reported_by_club_trainer_id")
  /// L1-INTERNAL
  value                   Decimal  @db.Decimal(12, 4)
  /// L1-INTERNAL
  measuredAt              DateTime @map("measured_at")
  /// L1-INTERNAL
  createdAt               DateTime @default(now()) @map("created_at")

  athlete          Athlete          @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  metricDefinition MetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)
  clubMembership   ClubMembership   @relation(fields: [clubMembershipId], references: [id], onDelete: Restrict)
  reportedBy       ClubTrainer      @relation(fields: [reportedByClubTrainerId], references: [id], onDelete: Restrict)

  @@index([athleteId, metricDefinitionId, measuredAt])
  @@index([clubMembershipId])
  @@map("athlete_metric_entries")
}

/// Derived from entries in the reportEntry transaction; never written by clients.
model AthleteMetricSummary {
  /// L1-INTERNAL
  athleteId          String   @map("athlete_id")
  /// L1-INTERNAL
  metricDefinitionId String   @map("metric_definition_id")
  /// L1-INTERNAL
  latestValue        Decimal  @map("latest_value") @db.Decimal(12, 4)
  /// L1-INTERNAL
  latestMeasuredAt   DateTime @map("latest_measured_at")
  /// L1-INTERNAL
  entryCount         Int      @map("entry_count")
  /// L1-INTERNAL
  updatedAt          DateTime @updatedAt @map("updated_at")

  athlete          Athlete          @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  metricDefinition MetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)

  @@id([athleteId, metricDefinitionId])
  @@map("athlete_metric_summaries")
}

/// Owner-only. A missing row resolves to PRIVATE for every category.
model AthleteVisibilitySettings {
  /// L1-INTERNAL
  athleteId               String             @id @map("athlete_id")
  /// L1-INTERNAL
  clubMembershipsAudience VisibilityAudience @default(PRIVATE) @map("club_memberships_audience")
  /// L1-INTERNAL
  metricsAudience         VisibilityAudience @default(PRIVATE) @map("metrics_audience")
  /// L1-INTERNAL
  updatedAt               DateTime           @updatedAt @map("updated_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Restrict)

  @@map("athlete_visibility_settings")
}

// ============================================================================
// Notifications (membership-notifications spec, design D9)
// ============================================================================

/// Expo push token for one device. Resolved server-side by the notifications
/// worker; never placed in job payloads. Deleted by deletePII.
model DeviceToken {
  /// L1-INTERNAL
  id            String         @id @default(cuid())
  /// L1-INTERNAL
  userAccountId String         @map("user_account_id")
  /// L1-INTERNAL
  token         String         @unique
  /// L1-INTERNAL
  platform      DevicePlatform
  /// L1-INTERNAL
  createdAt     DateTime       @default(now()) @map("created_at")
  /// L1-INTERNAL
  lastSeenAt    DateTime       @default(now()) @map("last_seen_at")

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Restrict)

  @@index([userAccountId])
  @@map("device_tokens")
}
